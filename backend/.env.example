PORT=5000
# Comma-separated for multiple frontends, e.g. https://careops-ai.vercel.app,https://www.example.com
ALLOWED_ORIGIN=http://localhost:5173

# Optional: exact URL patients open (used in WhatsApp payment/demo links). If unset, the first ALLOWED_ORIGIN is used.
# Set this on Railway when ALLOWED_ORIGIN lists several origins so links are not broken.
# FRONTEND_PUBLIC_URL=https://your-app.vercel.app

# Paste the entire JSON content of your Firebase service account key here (as a single line)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID",...}

GEMINI_API_KEY=your_gemini_api_key_here
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
