PORT=4000
# Comma-separated for multiple frontends, e.g. https://careops-ai-gamma.vercel.app,http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Exact URL for WhatsApp payment links (recommended in production)
# FRONTEND_PUBLIC_URL=https://your-app.vercel.app

# Firebase Admin — paste service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID",...}
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# Google AI (Gemini) — required for triage, SOAP notes, AI panel
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: GEMINI_MODEL=gemini-2.0-flash
# Optional: GEMINI_API_VERSION=v1beta

# Twilio WhatsApp — required for pharmacy ready notifications
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
